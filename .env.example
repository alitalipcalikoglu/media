# --- Server ---
PORT=3003
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- Storage ---
DB_PATH=./data/media.db
DATA_DIR=./data/files
# Soft-deleted files are purged (bytes removed) after this many days. 0 = next hourly run.
DELETE_GRACE_DAYS=7

# --- Identity of this service as seen by clients; used to build download and upload URLs.
PUBLIC_BASE_URL=https://media.example.com

# --- Callers: id:secret pairs, comma separated. Secrets >= 32 chars. Generate: openssl rand -hex 32
MEDIA_API_KEYS=shop-backend:REPLACE_WITH_64_HEX_CHARS
RATE_LIMIT_MAX=600

# --- Signed URLs for private files. Generate: openssl rand -hex 32
SIGNING_SECRET=REPLACE_WITH_64_HEX_CHARS
SIGNED_URL_TTL_SEC=900
UPLOAD_TICKET_TTL_SEC=900

# --- Uploads ---
MAX_UPLOAD_BYTES=26214400
# Sniffed types accepted. Supported: image/jpeg, image/png, image/webp, image/gif, image/avif, image/svg+xml, application/pdf
ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif,image/avif,application/pdf
# Decompression-bomb guard: width * height of any decoded image.
MAX_IMAGE_PIXELS=50000000
# Re-encode raster images on upload: drops EXIF/GPS/XMP, applies orientation, defeats polyglot files.
STRIP_IMAGE_METADATA=true

# --- Image variants: name:WIDTH (fit inside) or name:WIDTHxHEIGHT[:cover|inside|contain]. Served as WebP.
VARIANTS=thumb:200x200:cover,small:400,medium:800,large:1600
VARIANT_QUALITY=82

# --- Browsers that may upload with tickets or fetch files cross-origin. Comma separated origins, or *.
CORS_ORIGINS=https://shop.example.com

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=media:…:write
AUDIT_URL=
AUDIT_API_KEY=
